# Code d'acces de l'app (mettre la vraie valeur dans Vercel > Environment Variables)
AUTH_PASSWORD=0902

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Base publique des liens de demo (ex. https://prospects.nmf-agence.com).
# En dev, laisse vide : l'origine de la requete est utilisee.
NEXT_PUBLIC_DEMO_BASE_URL=

# Telephone NMF affiche dans le footer des demos (optionnel)
NEXT_PUBLIC_NMF_PHONE=

# Twilio SMS (numero FR en cours de validation).
# A remplir quand le numero est valide, puis creer un Messaging Service.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=MG...

# Anthropic (classement IA des reponses SMS - Claude Haiku).
# Sans cle, le classement retombe sur des mots-cles FR (suivi toujours fonctionnel).
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5

# Connection string Postgres Supabase (mode Session) pour les scripts/migrations DDL.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Secret partagé pour le déclencheur cron des blasts programmés (en-tête x-cron-secret)
CRON_SECRET=

# Apify — découverte Instagram (actors instagram-hashtag-scraper + instagram-profile-scraper).
# Token perso : apify.com > Settings > Integrations > API token.
APIFY_TOKEN=apify_api_...

# Telegram — notifs temps réel (démo ouverte, clic "Je le veux", paiement Stripe).
# Setup : @BotFather -> /newbot -> token ; envoyer un msg au bot puis lire le chat.id
# via https://api.telegram.org/bot<TOKEN>/getUpdates. Sans config : no-op.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Stripe — bouton "Je le veux" sur les démos (paiement en TOTALITÉ, pas d'acompte).
# Créer un Payment Link dans Stripe Dashboard (prix du site complet), le coller ici.
# Le webhook (Dashboard > Developers > Webhooks -> /api/stripe/webhook,
# event checkout.session.completed) passe le prospect en "positif" + notif Telegram.
STRIPE_PAYMENT_LINK=
STRIPE_WEBHOOK_SECRET=

# Code d'acces de l'app (mettre la vraie valeur dans Vercel > Environment Variables)
AUTH_PASSWORD=0902

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Base publique des liens de demo (ex. https://prospects.nmf-agence.com).
# En dev, laisse vide : l'origine de la requete est utilisee.
NEXT_PUBLIC_DEMO_BASE_URL=

# Telephone NMF affiche dans le footer des demos (optionnel)
NEXT_PUBLIC_NMF_PHONE=

# Twilio SMS (numero FR en cours de validation).
# A remplir quand le numero est valide, puis creer un Messaging Service.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=MG...

# Anthropic (classement IA des reponses SMS - Claude Haiku).
# Sans cle, le classement retombe sur des mots-cles FR (suivi toujours fonctionnel).
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5

# Connection string Postgres Supabase (mode Session) pour les scripts/migrations DDL.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

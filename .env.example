# Code d'acces de l'app (mettre la vraie valeur dans Vercel > Environment Variables)
AUTH_PASSWORD=0902

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Base publique des liens de demo (ex. https://prospects.nmf-agence.com).
# En dev, laisse vide : l'origine de la requete est utilisee.
NEXT_PUBLIC_DEMO_BASE_URL=

# Telephone NMF affiche dans le footer des demos (optionnel)
NEXT_PUBLIC_NMF_PHONE=

# Twilio SMS (numero FR en cours de validation).
# A remplir quand le numero est valide, puis creer un Messaging Service.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=MG...

# Anthropic (classement IA des reponses SMS - Claude Haiku).
# Sans cle, le classement retombe sur des mots-cles FR (suivi toujours fonctionnel).
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5

# Connection string Postgres Supabase (mode Session) pour les scripts/migrations DDL.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Secret partagé pour le déclencheur cron des blasts programmés (en-tête x-cron-secret)
CRON_SECRET=

# RapidAPI — SOURCE PRINCIPALE de la découverte Instagram (Apify désactivé).
# Une seule clé couvre les deux APIs abonnées (rapidapi.com > Apps > Security) :
#   - Instagram Looter (instagram-looter2)          — 150 req/mois : hashtags + profils
#   - Instagram Scraper Stable API                  —  20 req/mois : profils seuls
RAPIDAPI_KEY=

# Apify — DÉSACTIVÉ par défaut (crédits épuisés → il ralentissait chaque chasse).
# Le token peut rester posé, il n'est plus appelé. Pour le réactiver après une
# recharge de crédits : poser IG_ENABLE_APIFY=1 (il reprend la tête de chaîne).
APIFY_TOKEN=apify_api_...
IG_ENABLE_APIFY=

# Chaîne de priorité des sources (défaut : looter,stable ; +apify si réactivé).
# Sert à forcer un ordre — p. ex. "stable,looter".
IG_PROVIDER_ORDER=
# Logs visuels de la chasse Instagram (icônes [ig:…] dans les logs Vercel) :
# quelle source est tentée, sautée (et pourquoi), quel code HTTP / quota remonte.
# Activés par défaut. Poser IG_DEBUG=0 pour les couper.
IG_DEBUG=
# Plafond de profils résolus par scan direct chez un relais RapidAPI (défaut 12).
# Garde-fou double : leurs feeds hashtag ne donnent que des ids (chaque compte
# inconnu coûte une requête), et à ~5 s pièce un lot trop gros dépasse le
# maxDuration de la route. Pour du volume, passer par la file de pistes.
IG_RESOLVE_CAP=
# File de pistes : taille du lot et parallélisme. LAISSER VIDE en principe —
# ils sont déduits du plafond mensuel annoncé par le fournisseur (150 = gratuit
# → 12 en parallèle par 4 ; 15 000 = Pro → 100 par 10). Souscrire un plan
# supérieur accélère donc tout seul, sans rien changer ici.
IG_RESOLVE_BATCH=
IG_RESOLVE_CONCURRENCY=

# Sur-récupération du scan direct : posts scannés = target × facteur.
# Apify facture le post AU MÊME PRIX que le profil (0,0026 $) : le ×5 d'origine
# faisait payer 5 posts par profil obtenu et ramenait le crédit gratuit de
# 5 $/mois à ~320 prospects au lieu de ~910. Ne pas remonter sans raison.
IG_OVERFETCH_FACTOR=
IG_OVERFETCH_MAX=

# Telegram — notifs temps réel (démo ouverte, clic "Je le veux", paiement Stripe).
# Setup : @BotFather -> /newbot -> token ; envoyer un msg au bot puis lire le chat.id
# via https://api.telegram.org/bot<TOKEN>/getUpdates. Sans config : no-op.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Stripe — bouton "Je le veux" sur les démos (paiement en TOTALITÉ, pas d'acompte).
# Créer un Payment Link dans Stripe Dashboard (prix du site complet), le coller ici.
# Le webhook (Dashboard > Developers > Webhooks -> /api/stripe/webhook,
# event checkout.session.completed) passe le prospect en "positif" + notif Telegram.
STRIPE_PAYMENT_LINK=
STRIPE_WEBHOOK_SECRET=

# --- Funnel d'éligibilité (clone Lokads, test) ---
# Clé secrète Supabase (service_role) : écritures serveur du funnel (bypass RLS).
# Supabase > Project Settings > API > service_role secret.
SUPABASE_SECRET_KEY=sb_secret_...

# Base publique de l'app pour les liens SMS/email du funnel (ex. https://prospects.nmf-agence.com).
# En dev, laisse vide -> http://localhost:3000.
# Sur Vercel, laisse vide aussi : le domaine de prod est détecté via VERCEL_PROJECT_PRODUCTION_URL.
# À ne renseigner QUE quand ton vrai nom de domaine sera prêt (override).
NEXT_PUBLIC_APP_BASE_URL=

# Resend — emails transactionnels (confirmation + lancement).
# Crée un compte resend.com, récupère une API key.
# EN TEST : laisse RESEND_FROM vide -> onboarding@resend.dev (n'envoie qu'à TON email de compte).
# EN PROD : vérifie ton domaine, puis RESEND_FROM="Lokads <noreply@tondomaine.fr>".
RESEND_API_KEY=re_...
RESEND_FROM=

# Config du radar VPS — copier en `radar.env` sur le VPS (NE PAS committer radar.env).
# Les valeurs sont les memes que dans Vercel (Environment Variables) sauf SCRAPER_URL
# qui pointe sur le scraper LOCAL du VPS.

# Supabase — cle publishable (identique a NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY de l'app)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=sb_publishable_...

# Scraper local sur le VPS (defaut deja a localhost:8001 si non defini)
SCRAPER_URL=http://localhost:8001

# Twilio (memes valeurs que Vercel)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_MESSAGING_SERVICE_SID=MG...

# Numero qui recoit le SMS recap (defaut 0615907873)
RADAR_ADMIN_PHONE=0615907873
